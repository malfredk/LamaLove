---
import savedForecast from './weather.json';
import './weather.css';
import { WEDDING_DATE } from '../../../common/config/wedding.mjs';
import { FALLBACK, FORECAST_URL } from './config.mjs';
import type { Forecast } from './config.mjs';
import InfoBox from '../../../common/components/InfoBox.astro';
import { illustrations } from './illustrations';
import { weatherIllustration, weatherIntroduction, weatherRainChance, weatherTemperature } from './presentation.mjs';

interface Props {
  forecast?: Forecast;
  title?: string;
}

// A date change must never show a cached forecast for the previous date.
const defaultForecast: Forecast = savedForecast.date === WEDDING_DATE ? savedForecast : FALLBACK;
const { forecast = defaultForecast, title = 'Vær' } = Astro.props;
const illustration = illustrations[weatherIllustration(forecast)];
const chanceOfRain = weatherRainChance(forecast);
const temperatureText = weatherTemperature(forecast);
const sourceCredit = ['locationforecast', 'subseasonal'].includes(forecast.source ?? '')
  ? 'Værdata fra Meteorologisk institutt' : null;
---

<InfoBox title={title} lines={[]} illustration={illustration} illustrationHref={FORECAST_URL} illustrationLabel="Se værvarselet for Bergen på Yr">
  <p class="weather-introduction">{weatherIntroduction(forecast)}</p>
  {(chanceOfRain || temperatureText || sourceCredit) && <div class="weather-forecast">
    {chanceOfRain && <p class="weather-forecast__description">{chanceOfRain}</p>}
    {temperatureText && <p class="weather-forecast__temperature">{temperatureText}</p>}
    {sourceCredit && <p class="weather-forecast__note page-text-small">
      <a href={FORECAST_URL} title="Forenklet værvisning basert på data fra Meteorologisk institutt (MET Norway), tilgjengelig under NLOD 2.0 og CC BY 4.0.">{sourceCredit}</a>
    </p>}
  </div>}
</InfoBox>
