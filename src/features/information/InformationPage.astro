---
import Layout from "../../common/layouts/Layout.astro";
import InfoBoxes from "../../common/components/InfoBoxes.astro";
import InfoBox from "../../common/components/InfoBox.astro";
import { illustrations, type IllustrationName } from "./illustrations";

const infoItems: {
  title: string;
  lines: string[];
  illustration?: IllustrationName;
}[] = [
  {
    title: "Kleskode",
    illustration: "dress-and-tuxedo",
    lines: [
      "Smoking eller mørk dress for herrer og tilsvarende formelt for damer. Nasjonaldrakter er så klart velkommen.",
    ],
  },
  {
    title: "Gaver",
    illustration: "gift",
    lines: [
      "Vi ønsker oss først og fremst en hyggelig feiring med våre venner og kjære. Vi vet at mange av dere reiser langt for å være med oss, og det er i seg selv en fin gave.",
      "Ønsker du å gi noe, setter vi stor pris på bidrag til bryllupsreisen vår. Vi legger også ut en ønskeliste her når det nærmer seg.",
    ],
  },
  {
    title: "Toastmaster",
    illustration: "champagne",
    lines: ["Informasjon om toastmaster kommer."],
  },
  {
    title: "Barn",
    illustration: "rocking-horse",
    lines: [
      "Vi ønsker oss en barnefri feiring og håper dere har mulighet til å nyte en kveld uten barn sammen med oss! Dersom det er behov for å ha med små barn i vielsen, gi oss beskjed."
    ],
  },
];

const contacts = [
  { name: "Malene", phone: "41 65 15 19", email: "malenekf95@gmail.com" },
  { name: "Lars", phone: "94 47 29 68", email: "larsveggum@hotmail.com" },
];
---

<Layout title="L&M" activePage="information">
  <InfoBoxes items={[]}>
    {infoItems.map((item) => (
      <InfoBox title={item.title} lines={item.lines} illustration={item.illustration ? illustrations[item.illustration] : undefined} />
    ))}
    <InfoBox title="Kontakt" lines={[]} illustration={illustrations.envelope}>
      <Fragment slot="text">
        <p>Ikke nøl med å ta kontakt med brudeparet dersom du har spørsmål.</p>
        {
          contacts.map((contact) => (
            <p>
              {contact.name}:{"\u00A0\u00A0 "}
              <a href={`tel:+47${contact.phone.replaceAll(" ", "")}`}>
                {contact.phone}
              </a>
              ,{"\u00A0\u00A0 "}
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </p>
          ))
        }
      </Fragment>
    </InfoBox>
  </InfoBoxes>
</Layout>
