---
import "../styles/global.css";
import "../styles/nav.css";
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import backgroundSource from "../assets/background.png";
import { WEDDING_DATE, WEDDING_DATE_LABEL } from "../config/wedding.mjs";

const background = await getImage({
  src: backgroundSource,
  width: Math.min(backgroundSource.width, 1920),
  format: "webp",
  quality: 85,
});

interface Props {
  title?: string;
  activePage?: "home" | "information" | "timeline" | "visitor";
}

const { title = "L&M", activePage = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="no" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <link rel="preload" as="image" href={background.src} fetchpriority="high" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="icon" type="image/svg" href={`${base}/rings.svg`} />
  </head>

  <body style={`--page-background-image: url("${background.src}")`}>
    <main class:list={["page", { "page--home": activePage === "home" }]}>
      <header class="top-header">
        <a href={`${base}/`} class="names-link" aria-label="Gå til hjem" aria-current={activePage === "home" ? "page" : undefined}>
          <h1 class="names">Lars &amp; Malene</h1>
        </a>

        <p class="wedding-date">
          <time datetime={WEDDING_DATE}>{WEDDING_DATE_LABEL}</time>
        </p>

        <div class="nav-row">
          <div class="nav-center">
            <nav class="nav">
              <a
                href="https://docs.google.com/forms/d/e/1FAIpQLSf4KKQrjfa4TAMqrxjPYayEuRd9ZH6r2JAWrv56IEIv5px8AA/viewform?usp=header"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>svar på invitasjon</span>
                <span class="nav-width-reserve" aria-hidden="true"
                  >svar på invitasjon</span
                >
              </a>

              <a
                href={`${base}/information`}
                class={activePage === "information" ? "active" : ""}
                aria-current={activePage === "information" ? "page" : undefined}
              >
                <span>informasjon</span>
                <span class="nav-width-reserve" aria-hidden="true"
                  >informasjon</span
                >
              </a>

              <a
                href={`${base}/timeline`}
                class={activePage === "timeline" ? "active" : ""}
                aria-current={activePage === "timeline" ? "page" : undefined}
              >
                <span>program</span>
                <span class="nav-width-reserve" aria-hidden="true">program</span
                >
              </a>

              <a
                href={`${base}/visitor`}
                class={activePage === "visitor" ? "active" : ""}
                aria-current={activePage === "visitor" ? "page" : undefined}
              >
                <span>tilreisende</span>
                <span class="nav-width-reserve" aria-hidden="true"
                  >tilreisende</span
                >
              </a>
            </nav>
          </div>
        </div>
      </header>

      <slot />
    </main>
  </body>
</html>
