---
import "../styles/typography.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import backgroundSource from "../assets/background.png";

const background = await getImage({
  src: backgroundSource,
  width: Math.min(backgroundSource.width, 1920),
  format: "webp",
  quality: 100,
});

interface Props {
  title?: string;
  activePage?: "home" | "information" | "timeline" | "visitor" | "404";
}

const { title = "L&M", activePage = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="no" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <link rel="preload" as="image" href={background.src} fetchpriority="high" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Keep the font stylesheet loaded across client-side page changes. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&display=swap"
    />

    <link rel="icon" type="image/svg" href={`${base}/rings.svg`} />
  </head>

  <body style={`--page-background-image: url("${background.src}")`}>
    <main class:list={["page", { "page--home": activePage === "home" }]}>
      <Header activePage={activePage} />

      <slot />
    </main>
  </body>
</html>
