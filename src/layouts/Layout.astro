---
import "../styles/global.css";
import "../styles/nav.css";

interface Props {
  title?: string;
  activePage?: "home" | "information" | "timeline" | "visitor";
}

const { title = "L&M", activePage = "home" } = Astro.props;
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="icon" type="image/svg" href="/rings.svg" />
  </head>

  <body>
    <main class:list={["page", { "page--home": activePage === "home" }]}>
      <header class="top-header">
        <a href="/" class="names-link" aria-label="Gå til hjem">
          <h1 class="names">Lars &amp; Malene</h1>
        </a>

        <p class="wedding-date">
          <time datetime="2027-09-04">4. september 2027</time>
        </p>

        <div class="nav-row">
          <div class="nav-center">
            <nav class="nav">
              <a
                href="https://docs.google.com/forms/d/e/1FAIpQLSf4KKQrjfa4TAMqrxjPYayEuRd9ZH6r2JAWrv56IEIv5px8AA/viewform?usp=header"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>svar på invitasjon</span>
                <span class="nav-width-reserve" aria-hidden="true"
                  >svar på invitasjon</span
                >
              </a>

              <a
                href="/information"
                class={activePage === "information" ? "active" : ""}
              >
                <span>informasjon</span>
                <span class="nav-width-reserve" aria-hidden="true"
                  >informasjon</span
                >
              </a>

              <a
                href="/timeline"
                class={activePage === "timeline" ? "active" : ""}
              >
                <span>program</span>
                <span class="nav-width-reserve" aria-hidden="true">program</span
                >
              </a>

              <a
                href="/visitor"
                class={activePage === "visitor" ? "active" : ""}
              >
                <span>tilreisende</span>
                <span class="nav-width-reserve" aria-hidden="true"
                  >tilreisende</span
                >
              </a>
            </nav>
          </div>
        </div>
      </header>

      <slot />
    </main>
  </body>
</html>
