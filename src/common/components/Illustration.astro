---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  source: ImageMetadata;
  href?: string;
  label?: string;
}

const { source, href, label } = Astro.props;
const Tag = href ? 'a' : 'span';
const image = await getImage({ src: source, format: "webp" });

// Give every sketch the same area, so tall and wide drawings carry equal weight.
const ratio = source.width / source.height;
const style = [
  `--illustration: url("${image.src}")`,
  `--illustration-width: ${Math.sqrt(ratio).toFixed(3)}`,
  `--illustration-height: ${(1 / Math.sqrt(ratio)).toFixed(3)}`,
].join("; ");
---

<Tag class="info-illustration" style={style} href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined} aria-label={label} aria-hidden={href ? undefined : 'true'}>
  <span class="info-illustration__ink" aria-hidden="true"></span>
</Tag>
