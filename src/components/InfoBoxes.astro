---
import "../styles/information.css";

interface Props {
  items: { title: string; lines: string[] }[];
}

const { items } = Astro.props;
---

<section class="info-page">
  <div class="info-container">
    <div class="info-list">
      {
        items.map((item) => (
          <article class="info-box">
            <h3 class="page-subtitle">{item.title}</h3>
            <div class="info-text">
              {item.lines.map((line) => (
                <p>{line}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
