---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import InfoBox from "./InfoBox.astro";
import "../styles/photo-info-box.css";

interface Props {
  title: string;
  lines: string[];
  photos: { src: ImageMetadata; location: string }[];
}
const { title, lines, photos } = Astro.props;
---

<InfoBox title={title} lines={lines} class="photo-info-box">
  {
    photos.length > 0 && (
      <visitor-carousel aria-label={title} aria-roledescription="karusell">
        <div class="slides" aria-live="off">
          {photos.map((photo, index) => (
            <figure hidden={index !== 0}>
              <button
                type="button"
                class="photo-navigation"
                aria-label="Forrige bilde på venstre tredjedel, neste bilde på resten. Bruk piltastene eller Enter."
                disabled={photos.length < 2}
              >
              <Image
                src={photo.src}
                alt={photo.location}
                width={900}
                format="webp"
                quality={80}
                loading="eager"
                draggable="false"
              />
              </button>
              <figcaption>
                <p class="location">
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z"
                    />
                  </svg>
                  <span>{photo.location}</span>
                </p>
              </figcaption>
            </figure>
          ))}
        </div>
        {photos.length > 1 && (
          <div class="navigation-hint" aria-hidden="true">
            <span></span>
          </div>
        )}
      </visitor-carousel>
    )
  }
</InfoBox>

<script>
  class VisitorCarousel extends HTMLElement {
    private sizeObserver?: ResizeObserver;
    private sizingFrame?: number;

    connectedCallback() {
      const box = this.closest<HTMLElement>(".photo-info-box")!;
      const image = this.querySelector("img");
      let previousOverhead = -1;
      const fitPhoto = () => {
        if (!image) return;
        // Everything except the image must also fit inside the viewport.
        const overhead =
          box.getBoundingClientRect().height -
          image.getBoundingClientRect().height;
        if (Math.abs(overhead - previousOverhead) < 0.5) return;
        previousOverhead = overhead;
        this.style.setProperty("--box-overhead", `${overhead}px`);
      };
      this.sizeObserver = new ResizeObserver(() => {
        window.cancelAnimationFrame(this.sizingFrame);
        this.sizingFrame = window.requestAnimationFrame(fitPhoto);
      });
      this.sizeObserver.observe(box);
      fitPhoto();
      const slides = Array.from(this.querySelectorAll("figure"));
      if (slides.length < 2) return;
      const hint = this.querySelector<HTMLElement>(".navigation-hint")!;
      const hintArrow = hint.querySelector("span")!;
      const indicate = (direction: number) => {
        hintArrow.textContent = direction < 0 ? "\u2190" : "\u2192";
        hint.dataset.direction = direction < 0 ? "previous" : "next";
      };
      const live = this.querySelector<HTMLElement>(".slides")!;
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const paused = reducedMotion.matches;
      let current = 0;
      let hoverSuppressed = false;
      let lastTouchTime = -Infinity;
      live.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse" || hoverSuppressed || performance.now() - lastTouchTime < 1000) return;
        const bounds = live.getBoundingClientRect();
        if (event.clientY >= bounds.top + hint.offsetHeight) {
          hint.classList.remove("is-hovered");
          return;
        }
        indicate(event.clientX < bounds.left + bounds.width / 3 ? -1 : 1);
        hint.classList.add("is-hovered");
      });
      this.addEventListener("pointerleave", () => {
        hoverSuppressed = false;
        hint.classList.remove("is-hovered");
      });
      const show = (index: number) => {
        const previous = current;
        current = (index + slides.length) % slides.length;
        window.clearTimeout(this.transitionTimer);
        slides.forEach((slide, i) => {
          slide.removeAttribute("data-leaving");
          slide.hidden = i !== current;
        });
        if (previous !== current && !reducedMotion.matches) {
          slides[previous].setAttribute("data-leaving", "");
          this.transitionTimer = window.setTimeout(() => {
            slides[previous].removeAttribute("data-leaving");
          }, 500);
        }
      };
      const move = (direction: number) => {
        window.clearInterval(this.timer);
        live.setAttribute("aria-live", "polite");
        show(current + direction);
      };
      this.querySelectorAll<HTMLButtonElement>(".photo-navigation").forEach((button) => {
        let start: { id: number; x: number; y: number } | undefined;
        let suppressClick = false;
        const directionAt = (x: number) => {
          const bounds = button.getBoundingClientRect();
          return x < bounds.left + bounds.width / 3 ? -1 : 1;
        };
        button.addEventListener("pointerdown", (event) => {
          if (!event.isPrimary || event.button !== 0) return;
          if (event.pointerType === "touch") lastTouchTime = performance.now();
          suppressClick = false;
          hoverSuppressed = true;
          indicate(directionAt(event.clientX));
          hint.classList.remove("is-hovered");
          hint.classList.add("is-pressed");
          start = { id: event.pointerId, x: event.clientX, y: event.clientY };
          button.setPointerCapture(event.pointerId);
        });
        button.addEventListener("pointerup", (event) => {
          if (!start || start.id !== event.pointerId) return;
          const dx = event.clientX - start.x;
          const dy = event.clientY - start.y;
          start = undefined;
          hint.classList.remove("is-pressed");
          suppressClick = Math.abs(dx) > 10 || Math.abs(dy) > 10;
          if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) {
            move(dx < 0 ? 1 : -1);
          } else if (!suppressClick) {
            move(directionAt(event.clientX));
          }
        });
        button.addEventListener("pointercancel", () => {
          start = undefined;
          suppressClick = true;
          hint.classList.remove("is-pressed", "is-hovered");
        });
        button.addEventListener("click", (event) => {
          // Pointer navigation is handled once on release; retain keyboard activation.
          event.preventDefault();
          if (event.detail === 0 && !(event instanceof PointerEvent && event.pointerType)) move(1);
        });
        button.addEventListener("keydown", (event) => {
          if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
            event.preventDefault();
            move(event.key === "ArrowLeft" ? -1 : 1);
          }
        });
      });
      this.timer = window.setInterval(() => {
        if (
          !paused &&
          !document.hidden &&
          !this.matches(":hover, :focus-within")
        ) {
          live.setAttribute("aria-live", "off");
          show(current + 1);
        }
      }, 3000);
    }
    timer?: number;
    private transitionTimer?: number;
    disconnectedCallback() {
      window.clearInterval(this.timer);
      window.clearTimeout(this.transitionTimer);
      this.sizeObserver?.disconnect();
      window.cancelAnimationFrame(this.sizingFrame);
    }
  }
  if (!customElements.get("visitor-carousel"))
    customElements.define("visitor-carousel", VisitorCarousel);
</script>
