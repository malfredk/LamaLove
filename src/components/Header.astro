---
import { WEDDING_DATE, WEDDING_DATE_LABEL } from "../config/wedding.mjs";

interface Props {
  activePage?: string;
}

const { activePage = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pages = [
  { id: "information", label: "informasjon" },
  { id: "timeline", label: "program" },
  { id: "visitor", label: "tilreisende" },
];
---

<header class="top-header">
  <a href={`${base}/`} class="names-link" aria-label="Gå til hjem" aria-current={activePage === "home" ? "page" : undefined}>
    <h1 class="names">Lars &amp; Malene</h1>
  </a>

  <p class="wedding-date">
    <time datetime={WEDDING_DATE}>{WEDDING_DATE_LABEL}</time>
  </p>

  <div class="nav-row">
    <div class="nav-center">
      <nav class="nav">
        <div class="nav-group nav-invitation">
          <a
            href="https://docs.google.com/forms/d/e/1FAIpQLSf4KKQrjfa4TAMqrxjPYayEuRd9ZH6r2JAWrv56IEIv5px8AA/viewform?usp=header"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>svar på invitasjon</span>
            <span class="nav-width-reserve nav-width-reserve-normal" aria-hidden="true">svar på invitasjon</span>
            <span class="nav-width-reserve" aria-hidden="true">svar på invitasjon</span>
          </a>
        </div>
        <span class="nav-separator nav-row-separator" aria-hidden="true"></span>
        <div class="nav-group nav-options">
          {pages.map((page, index) => (
            <Fragment>
              {index > 0 && <span class="nav-separator" aria-hidden="true"></span>}
              <a
                href={`${base}/${page.id}`}
                class={activePage === page.id ? "active" : undefined}
                aria-current={activePage === page.id ? "page" : undefined}
              >
                <span>{page.label}</span>
                <span class="nav-width-reserve nav-width-reserve-normal" aria-hidden="true">{page.label}</span>
                <span class="nav-width-reserve" aria-hidden="true">{page.label}</span>
              </a>
            </Fragment>
          ))}
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  /* The complete shared header appearance is defined here, including mobile. */
  :global(:root) {
    --names-font-size: clamp(3.4rem, 7vw, 6.5rem);
    --names-font-weight: 500;
    --names-letter-spacing: 0.06em;
    --names-line-height: 1;

    --header-date-size: 1.18rem;
    --header-date-weight: 500;
    --header-date-spacing: 0.02em;
    --header-date-line-height: 1.65;
    --header-date-gap: 0.7rem;
    --header-nav-gap: 1.8rem;

    --nav-text-size: 0.9rem;
    --nav-text-weight: 500;
    --nav-letter-spacing: 0.22em;
    --nav-line-height: 1.2;
    --nav-active-weight: 700;
  }

  .top-header {
    /* Explicit rows avoid extra spacing from an inline text baseline. */
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.8rem 1.5rem 1rem;
    background: var(--translucent-cream);
    text-align: center;
    font-family: var(--font-family);
  }

  /* The home page already applies this cream tint to its whole background. */
  :global(.page--home) .top-header {
    background: transparent;
  }

  .names-link {
    display: block;
    max-width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .names {
    margin: 0;
    font-size: var(--names-font-size);
    font-weight: var(--names-font-weight);
    line-height: var(--names-line-height);
    letter-spacing: var(--names-letter-spacing);
    color: var(--text);
  }

  .wedding-date {
    margin: var(--header-date-gap) 0 0;
    font-size: var(--header-date-size);
    font-weight: var(--header-date-weight);
    line-height: var(--header-date-line-height);
    letter-spacing: var(--header-date-spacing);
  }

  .nav-row {
    margin: var(--header-nav-gap) auto 0;
    width: 100%;
    max-width: 1040px;
    display: flex;
    justify-content: center;
  }

  .nav-center {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Hairline rules above and below, like a printed invitation. */
  .nav {
    --nav-rule: color-mix(in srgb, var(--text) 40%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-block: 1px solid var(--nav-rule);
  }

  .nav-group {
    display: flex;
    align-items: center;
  }

  .nav a {
    position: relative;
    display: grid;
    text-align: center;
    text-decoration: none;
    font-size: var(--nav-text-size);
    font-weight: var(--nav-text-weight);
    line-height: var(--nav-line-height);
    letter-spacing: var(--nav-letter-spacing);
    text-transform: uppercase;
    padding: 0.8rem 1.5rem;
    color: var(--text);
  }

  /* Separators are elements between options, never before a row's first link. */
  .nav-separator {
    flex: 0 0 4px;
    width: 4px;
    height: 4px;
    margin-inline: -2px;
    background: var(--nav-rule);
    transform: rotate(45deg);
  }

  .nav-row-separator {
    display: none;
  }

  /* The groups share a separator only when they share a row. */
  @media (width > 860px) {
    .nav-row-separator {
      display: block;
    }
  }

  /* Balance trailing letter spacing so labels and underlines stay centered. */
  .nav a > span {
    grid-area: 1 / 1;
    justify-self: center;
    text-indent: var(--nav-letter-spacing);
  }

  .nav a .nav-width-reserve {
    visibility: hidden;
    font-weight: var(--nav-active-weight);
  }

  /* Both weights keep the same grid dimensions, including on Home. */
  .nav a .nav-width-reserve-normal {
    font-weight: var(--nav-text-weight);
  }

  .nav a > span:first-child {
    position: relative;
  }

  .nav a > span:first-child::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.4em;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
    transform: scaleX(0);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav a:not(.active):hover > span:first-child::after {
    transform: scaleX(1);
  }

  .nav a.active > span:first-child {
    font-weight: var(--nav-active-weight);
    -webkit-text-stroke: 0.4px currentColor;
  }

  .nav a:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a > span:first-child::after {
      transition: none;
    }
  }

  /* The invitation sits above the three page links on narrow screens. */
  @media (max-width: 860px) {
    .nav-center {
      width: min(100%, 28rem);
    }

    .nav {
      flex-direction: column;
      align-items: stretch;
      align-self: stretch;
    }

    .nav a {
      padding: 0.7rem 0.6rem;
    }

    .nav-group a {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 720px) {
    :global(:root) {
      --header-date-size: 1.05rem;
      --header-date-line-height: 1.6;
      --nav-text-size: 0.74rem;
      --nav-letter-spacing: 0.14em;
    }

    .top-header {
      padding-top: 2rem;
    }
  }

  @media (max-width: 420px) {
    :global(:root) {
      --nav-text-size: 0.68rem;
      --nav-letter-spacing: 0.1em;
    }

    .top-header {
      padding-inline: 0.75rem;
    }

    .nav a {
      padding-inline: 0.4rem;
    }
  }
</style>
