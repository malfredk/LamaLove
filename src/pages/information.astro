---
import Layout from "../layouts/Layout.astro";
import "../styles/information.css";

const infoItems = [
  {
    title: "Kleskode",
    lines: [
      "Smoking eller mørk dress for herrer og tilsvarende formelt for damer. Nasjonaldrakter er så klart velkommen.",
    ],
  },
  {
    title: "Gaver",
    lines: [
      "Vi ønsker oss først og fremst en hyggelig feiring med våre venner og kjære. Vi forventer ingen gaver utover dette.",
      "Dersom du allikevel ønsker å gi en gave, setter vi stor pris på et bidrag til bryllupsreisen. Vi har også laget en ønskeliste hos Illums: https://www.illums.no/wishlist/123456789.",
    ],
  },
  {
    title: "Toastmaster",
    lines: [
      "Vår toastmaster er Ola Nordmann. Dersom du ønsker å bidra med tale eller underholdning, kan h*n kontaktes på ...",
    ],
  },
  {
    title: "Barn",
    lines: [
      "Dette er et barnefritt arrangement. Vi håper dere har muligheten til å nyte en barnefri kveld sammen med oss.",
    ],
  },
  {
    title: "Spørsmål",
    lines: [
      "Ikke nøl med å ta kontakt med brudeparet eller toastmaster dersom du har spørsmål.",
    ],
  },
];
---

<Layout title="L&M" activePage="information">
  <section class="info-page">
    <div class="info-container">

      <div class="info-list">
        {infoItems.map((item, index) => (
          <>
            <article class="info-box">
              <h3>{item.title}</h3>

              <div class="info-text">
                {item.lines.map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            </article>

            {index < infoItems.length - 1 && <div class="info-divider"></div>}
          </>
        ))}
      </div>
    </div>
  </section>
</Layout>