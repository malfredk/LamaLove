---
import Layout from "../layouts/Layout.astro";
import "../styles/information.css";

const infoItems = [
  {
    title: "Kleskode",
    lines: [
      "Smoking eller mørk dress for herrer og tilsvarende formelt for damer. Nasjonaldrakter er så klart velkommen.",
    ],
  },
  {
    title: "Gaver",
    lines: [
      "Vi ønsker oss først og fremst en hyggelig feiring med våre venner og kjære. Vi forventer ingen gaver utover dette.",
      "Dersom du allikevel ønsker å gi en gave så kommer vi til å lage en ønskeliste når det nærmer seg.",
    ],
  },
  {
    title: "Toastmaster",
    lines: [
      "Informasjon om toastmaster kommer.",
    ],
  },
  {
    title: "Barn",
    lines: [
      "Dette er et barnefritt arrangement, men gi en lyd dersom du vil ha med barn i vielsen. Vi håper dere har muligheten til å nyte en barnefri kveld sammen med oss.",
    ],
  },
  {
    title: "Spørsmål",
    lines: [
      "Ikke nøl med å ta kontakt med brudeparet dersom du har spørsmål.",
    ],
  },
  {
    title: "Kontakt",
    lines: [
      "Malene: 41 65 15 19",
      "Lars: 94 47 29 68",
    ],
  },
];
---

<Layout title="L&M" activePage="information">
  <section class="info-page">
    <div class="info-container">

      <div class="info-list">
        {infoItems.map((item) => (
            <article class="info-box">
              <h3 class="page-subtitle">{item.title}</h3>

              <div class="info-text">
                {item.lines.map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            </article>

        ))}
      </div>
    </div>
  </section>
</Layout>
