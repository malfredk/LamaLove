---
import Layout from "../layouts/Layout.astro";
import InfoBoxes from "../components/InfoBoxes.astro";
import InfoBox from "../components/InfoBox.astro";

const infoItems = [
  {
    title: "Kleskode",
    lines: [
      "Smoking eller mørk dress for herrer og tilsvarende formelt for damer. Nasjonaldrakter er så klart velkommen.",
    ],
  },
  {
    title: "Gaver",
    lines: [
      "Vi ønsker oss først og fremst en hyggelig feiring med våre venner og kjære. Vi forventer ikke gave utover dette.",
      "Dersom du allikevel ønsker å gi en gave så setter vi stor pris på bidrag til vår bryllupsreise. Vi kommer også til å lage en ønskeliste her når det nærmer seg.",
    ],
  },
  {
    title: "Toastmaster",
    lines: ["Informasjon om toastmaster kommer."],
  },
  {
    title: "Barn",
    lines: [
      "Dette er et barnefritt arrangement, men gi en lyd dersom du vil ha med barn i vielsen. Vi håper dere har muligheten til å nyte en barnefri kveld sammen med oss.",
    ],
  },
  {
    title: "Spørsmål",
    lines: ["Ikke nøl med å ta kontakt med brudeparet dersom du har spørsmål."],
  },
];

const contacts = [
  { name: "Malene", phone: "41 65 15 19", email: "malenekf95@gmail.com" },
  { name: "Lars", phone: "94 47 29 68", email: "larsveggum@hotmail.com" },
];
---

<Layout title="L&M" activePage="information">
  <InfoBoxes items={infoItems}>
    <InfoBox title="Kontakt" lines={[]}>
      <Fragment slot="text">
        {
          contacts.map((contact) => (
            <p>
              {contact.name}:{"\u00A0\u00A0 "}
              <a href={`tel:+47${contact.phone.replaceAll(" ", "")}`}>
                {contact.phone}
              </a>
              ,{"\u00A0\u00A0 "}
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </p>
          ))
        }
      </Fragment>
    </InfoBox>
  </InfoBoxes>
</Layout>
