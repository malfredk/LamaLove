---
import Layout from "../layouts/Layout.astro";
import InfoBoxes from "../components/InfoBoxes.astro";
import InfoBox from "../components/InfoBox.astro";
import PhotoInfoBox from "../components/PhotoInfoBox.astro";
import ll from "../assets/bergen_photos/IMG_0140.JPG";
import hval from "../assets/bergen_photos/IMG_0181.JPG";
import bryggen from "../assets/bergen_photos/IMG_1822.JPG";
import kode from "../assets/bergen_photos/IMG_5700.JPG";
import is from "../assets/bergen_photos/IMG_0889.jpg";
import skostredet from "../assets/bergen_photos/IMG_0208.JPG";

// Each photo is captioned with its location.
const bergenPhotos = [
  { src: ll, location: "Lille Lungegårdsvannet" },
  { src: hval, location: "Naturhistorisk museum" },
  { src: bryggen, location: "Bryggen" },
  { src: kode, location: "Kode museum, Rasmus Meyer" },
  { src: is, location: "Fløyen" },
  { src: skostredet, location: "Skostredet" },
];

const visitorItems = [
  {
    title: "Attraksjoner",
    lines: [
      "Hvis du har litt tid til overs så har Bergen mye å by på. Eksempler på hvordan en østlending kan nyte byen:",
    ],
  },
];
---

<Layout title="L&M" activePage="visitor">
  <InfoBoxes items={[]}>
    <InfoBox title="Hotell" lines={[]}>
      <Fragment slot="text">
        <p>
          Dersom du ønsker å bo på hotell <a href="https://www.hotelcharmante.no/" target="_blank" rel="noopener noreferrer">Charmante</a>,
          hvor middagen og festen er, så kan du bruke koden
          <span class="hotel-code">
            <button type="button" class="copy-code" aria-label="Kopier koden larsogmalene">
              <strong>larsogmalene</strong>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                <rect x="8" y="8" width="12" height="13" rx="1" />
                <path d="M16 8V3H4v13h4" />
              </svg>
            </button>
            <span class="copy-status" role="status"></span>
          </span>
          for litt rabatt.
        </p>
      </Fragment>
    </InfoBox>
    <InfoBox title="Spisesteder" lines={[]}>
      <Fragment slot="text">
        <p>
          Vi regner med det blir strålende sol og anbefaler derfor turen innom
          iskremkiosken
          <a
            href="https://maps.app.goo.gl/CjNibpxQCDifWSTb6"
            target="_blank"
            rel="noopener noreferrer">Hallaisen</a
          >. Dersom det mot alle odds ikke skulle bli sol så har de òg varm drikke.
        </p>
        <p>
          Dersom du skal ut og spise i løpet av oppholdet, anbefaler vi blant
          annet
          <a
            href="https://maps.app.goo.gl/M7uNLrxRbiQU65KK9"
            target="_blank"
            rel="noopener noreferrer">Allmuen</a
          >,
          <a
            href="https://maps.app.goo.gl/KjW2sueMG1uLLgcN6"
            target="_blank"
            rel="noopener noreferrer">Villani</a
          > og
          <a
            href="https://maps.app.goo.gl/A4Tes9QhHbgLCQBA7"
            target="_blank"
            rel="noopener noreferrer">Frk. Schmidt</a
          >.
        </p>
      </Fragment>
    </InfoBox>
    <PhotoInfoBox
      {...visitorItems[visitorItems.length - 1]}
      photos={bergenPhotos}
    />
  </InfoBoxes>
</Layout>

<style>
  .hotel-code {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin-inline: 0.25em;
    white-space: nowrap;
  }

  .hotel-code strong {
    font-family: ui-monospace, "Cascadia Code", "Courier New", monospace;
    font-size: 0.85em;
    font-weight: 700;
    user-select: all;
  }

  .copy-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.15em;
    padding: 0;
    border: 0;
    font: inherit;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .copy-code svg { width: 0.75em; height: 0.75em; }
  .copy-code:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; }
  .copy-status {
    position: absolute;
    bottom: calc(100% + 0.3rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    padding: 0.25em 0.6em;
    background: var(--background);
    color: var(--text);
    font-size: 0.75em;
    line-height: 1.4;
    box-shadow: 0 2px 8px rgb(0 0 0 / 8%);
    pointer-events: none;
  }
  .copy-status.is-visible {
    animation: copy-feedback 1500ms ease-out forwards;
  }
  @keyframes copy-feedback {
    0%, 75% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .copy-status.is-visible { animation: none; }
  }
  .copy-status:empty { display: none; }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>(".copy-code");
  const copyStatus = document.querySelector<HTMLElement>(".copy-status");
  if (copyButton && copyStatus) {
    let statusTimer: ReturnType<typeof setTimeout>;
    copyButton.addEventListener("click", async () => {
      clearTimeout(statusTimer);
      copyStatus.classList.remove("is-visible");
      try {
        await navigator.clipboard.writeText("larsogmalene");
        copyStatus.textContent = "Koden er kopiert";
      } catch {
        copyStatus.textContent = "Marker og kopier koden manuelt.";
      }
      // Restart the feedback animation on every copy.
      void copyStatus.offsetWidth;
      copyStatus.classList.add("is-visible");
      statusTimer = setTimeout(() => {
        copyStatus.textContent = "";
        copyStatus.classList.remove("is-visible");
      }, 1500);
    });
  }
</script>
