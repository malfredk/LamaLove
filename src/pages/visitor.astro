---
import Layout from "../layouts/Layout.astro";
import InfoBoxes from "../components/InfoBoxes.astro";
import InfoBox from "../components/InfoBox.astro";
import PhotoInfoBox from "../components/PhotoInfoBox.astro";
import HotelDiscountCode from "../components/HotelDiscountCode.astro";
import lilleLungegaardsvannetPhoto from "../assets/bergen_photos/IMG_0140.JPG";
import naturalHistoryMuseumPhoto from "../assets/bergen_photos/IMG_0181.JPG";
import bryggenPhoto from "../assets/bergen_photos/IMG_1822.JPG";
import kodeMuseumPhoto from "../assets/bergen_photos/IMG_5700.JPG";
import floeyenPhoto from "../assets/bergen_photos/IMG_0889.jpg";
import skostredetPhoto from "../assets/bergen_photos/IMG_0208.JPG";

// Each photo is captioned with its location.
const bergenPhotos = [
  { src: lilleLungegaardsvannetPhoto, location: "Lille Lungegårdsvannet" },
  { src: naturalHistoryMuseumPhoto, location: "Naturhistorisk museum" },
  { src: bryggenPhoto, location: "Bryggen" },
  { src: kodeMuseumPhoto, location: "Kode museum, Rasmus Meyer" },
  { src: floeyenPhoto, location: "Fløyen" },
  { src: skostredetPhoto, location: "Skostredet" },
];

const attractions = {
  title: "Attraksjoner",
  lines: [
    "Hvis du har litt tid til overs så har Bergen mye å by på. Eksempler på hvordan en østlending kan nyte byen:",
  ],
};
---

<Layout title="L&M" activePage="visitor">
  <InfoBoxes items={[]}>
    <InfoBox title="Hotell" lines={[]}>
      <Fragment slot="text">
        <p>
          Dersom du ønsker å bo på hotell <a href="https://www.hotelcharmante.no/" target="_blank" rel="noopener noreferrer">Charmante</a>,
          hvor middagen og festen er, så kan du bruke koden
          <HotelDiscountCode />
          for litt rabatt.
        </p>
      </Fragment>
    </InfoBox>
    <InfoBox title="Spisesteder" lines={[]}>
      <Fragment slot="text">
        <p>
          Vi regner med det blir strålende sol og anbefaler derfor turen innom
          iskremkiosken{" "}
          <a
            href="https://maps.app.goo.gl/CjNibpxQCDifWSTb6"
            target="_blank"
            rel="noopener noreferrer">Hallaisen</a
          >. Dersom det mot alle odds ikke skulle bli sol så har de òg varm drikke.
        </p>
        <p>
          Dersom du skal ut og spise i løpet av oppholdet, anbefaler vi blant
          annet{" "}
          <a
            href="https://maps.app.goo.gl/M7uNLrxRbiQU65KK9"
            target="_blank"
            rel="noopener noreferrer">Allmuen</a
          >,{" "}
          <a
            href="https://maps.app.goo.gl/KjW2sueMG1uLLgcN6"
            target="_blank"
            rel="noopener noreferrer">Villani</a
          > og{" "}
          <a
            href="https://maps.app.goo.gl/A4Tes9QhHbgLCQBA7"
            target="_blank"
            rel="noopener noreferrer">Frk. Schmidt</a
          >.
        </p>
      </Fragment>
    </InfoBox>
    <PhotoInfoBox
      {...attractions}
      photos={bergenPhotos}
    />
  </InfoBoxes>
</Layout>
