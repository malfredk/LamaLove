---
import Layout from "../layouts/Layout.astro";
import "../styles/timeline.css";

interface TimelineEvent {
  time?: string;
  description: string;
  location?: string;
  address?: string;
  addressLink?: string;
  weddingRings?: boolean;
}

// Add or remove events here. Only description is required; events appear in list order.
// Set addressLink to make an event's address clickable.
const days: { heading: string; events: TimelineEvent[] }[] = [
  {
    heading: "fredag",
    events: [
      { description: "Uformell frivillig samling" },
    ],
  },
  {
    heading: "lørdag",
    events: [
      { time: "14:00", description: "Vielse", location: "Opus XVI", address: "Vågsallmenningen 16, 5014 Bergen", addressLink: "https://maps.app.goo.gl/hUo9V2RBUWuAWjxy9", weddingRings: true },
      { description: "Aperitiff", location: "Charmante", address: "Skostredet 14, 5017 Bergen", addressLink: "https://maps.app.goo.gl/jHG9fudPWxTiyjPL6" },
      { description: "Middag" },
      { description: "Fest" },
      { time: "02:00", description: "Slutt" },
    ],
  },
];
---

<Layout title="L&M" activePage="timeline">
  <div class="timeline-page">
    {days.map((day, index) => (
      <section class="timeline-day" aria-labelledby={`day-${index}`}>
        <h2 class="page-subtitle" id={`day-${index}`}>{day.heading}</h2>
        <ol class="timeline-events">
          {day.events.map((event) => (
            <li class="timeline-event">
              {event.time ? <time datetime={event.time}>{event.time}</time> : <span aria-hidden="true"></span>}
              <span class="timeline-marker" aria-hidden="true">
                {event.weddingRings && <span class="timeline-marker__second-ring"></span>}
              </span>
              <div class="timeline-details">
                <h3>{event.description}</h3>
                {event.location && <p>{event.location}</p>}
                {event.address && (
                  <p>
                    {event.addressLink ? <a href={event.addressLink} target="_blank" rel="noopener noreferrer">{event.address}</a> : event.address}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>
