---
import Layout from "../layouts/Layout.astro";
import "../styles/timeline.css";

interface TimelineEvent {
  time: string;
  description?: string;
  location?: string;
  address?: string;
  weddingRings?: boolean;
}

// Add or remove events here. Only time is required; events appear in list order.
const days: { heading: string; events: TimelineEvent[] }[] = [
  {
    heading: "fredag",
    events: [
      { time: "19:00", description: "Uformell frivillig samling", location: "Tempo Tempo", address: "Domkirkegaten 6A, 5017 Bergen" },
    ],
  },
  {
    heading: "lørdag",
    events: [
      { time: "14:00", description: "Vielse", location: "Opus XVI", address: "Vågsallmenningen 16, 5014 Bergen", weddingRings: true },
      { time: "15:00", description: "Aperitiff", location: "Charmante", address: "Skostredet 14, 5017 Bergen" },
      { time: "17:00", description: "Middag" },
      { time: "20:00", description: "Fest" },
      { time: "01:00", description: "Slutt" },
    ],
  },
];
---

<Layout title="L&M" activePage="timeline">
  <div class="timeline-page">
    {days.map((day, index) => (
      <section class="timeline-day" aria-labelledby={`day-${index}`}>
        <h2 class="page-subtitle" id={`day-${index}`}>{day.heading}</h2>
        <ol class="timeline-events">
          {day.events.map((event) => (
            <li class="timeline-event">
              <time datetime={event.time}>{event.time}</time>
              <span class="timeline-marker" aria-hidden="true">
                {event.weddingRings && <span class="timeline-marker__second-ring"></span>}
              </span>
              <div class="timeline-details">
                {event.description && <h3>{event.description}</h3>}
                {event.location && <p>{event.location}</p>}
                {event.address && <p>{event.address}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>
